# ============================================================
# Flow v7.1 — Environment Variables (names only, NO real secrets)
# ============================================================
#
# RULE: anything prefixed VITE_ is bundled into browser JavaScript and is PUBLIC.
# NEVER place a service-role key or third-party private API key behind a VITE_ prefix.

# ---------- Vite / browser (public by design) ----------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_BASE_URL=http://localhost:5173
VITE_OPENFREEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ============================================================
# The values below are Supabase Edge Function secrets.
# Set them with `supabase secrets set ...` — NEVER in the frontend.
# They are listed here only for documentation of what the backend needs.
# ============================================================
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# OPENWEATHER_API_KEY=
# GEOAPIFY_API_KEY=
# TAVILY_API_KEY=
# NVIDIA_API_KEY=
# NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# NVIDIA_REASONING_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# APP_BASE_URL=
# ALLOWED_ORIGINS=http://localhost:5173
# ADMIN_USER_IDS=

# ============================================================
# Seed script (scripts/seed-venues.ts) — server-side only, run locally.
# ============================================================
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# GEOAPIFY_API_KEY=
